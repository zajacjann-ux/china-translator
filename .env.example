# Rabbitalk — environment variables
# Copy to .env for local development: cp .env.example .env

# Required — OpenAI API key (also set in EAS for cloud builds)
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-openai-api-key

# Optional model overrides (defaults below match eas.json build profiles)
EXPO_PUBLIC_OPENAI_STT_MODEL=whisper-1
EXPO_PUBLIC_OPENAI_TRANSLATION_MODEL=gpt-4o
EXPO_PUBLIC_OPENAI_TTS_MODEL=tts-1
EXPO_PUBLIC_OPENAI_TTS_SPEED=0.85
# Default TTS voice fallback (per-language voices are in src/config/languages.config.ts)
EXPO_PUBLIC_OPENAI_TTS_VOICE=alloy

# EAS Build — set secrets in Expo dashboard or CLI:
# eas env:create EXPO_PUBLIC_OPENAI_API_KEY --value sk-... --environment preview,production --visibility secret --scope project
