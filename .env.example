# Rabbitalk — environment variables
EXPO_PUBLIC_OPENAI_API_KEY=sk-your-key-here

# Optional: override default OpenAI models (used in future implementation)
EXPO_PUBLIC_OPENAI_STT_MODEL=whisper-1
EXPO_PUBLIC_OPENAI_TRANSLATION_MODEL=gpt-4o-mini
EXPO_PUBLIC_OPENAI_TTS_MODEL=tts-1
# Default TTS voice fallback (per-language voices are in src/config/languages.config.ts)
EXPO_PUBLIC_OPENAI_TTS_VOICE=alloy

# EAS Build project ID (set after running `eas init`)
# EAS_PROJECT_ID=
